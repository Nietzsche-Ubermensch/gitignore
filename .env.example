# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and replace placeholder values with real credentials.
# NEVER commit the .env file — it is excluded via .gitignore.
# =============================================================================

# --- API Keys ---
API_KEY=your-api-key-here
API_SECRET=your-api-secret-here

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Third-Party Services ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# --- Vault (if using HashiCorp Vault) ---
VAULT_ADDR=https://vault.example.com
VAULT_ROLE_ID=your-vault-approle-role-id
VAULT_SECRET_ID=your-vault-approle-secret-id
# VAULT_TOKEN=your-vault-token  # optional alternative auth method

# --- Application ---
APP_ENV=development
APP_PORT=8080
